	(text "Kelvin SET return: \nR32 and C53 share this return node. \nRoute it directly to C54 negative/load ground. \nDo not connect this node to U13 GND \nor the ground plane before C54−."
		(exclude_from_sim no)
		(at 161.798 59.69 0)
		(effects
