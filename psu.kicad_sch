	(text "PCB layout: \nPlace C3/C5 close to VIN and PGND.\nPlace C28/C32 close to VOUT and PGND.\nKeep R12, R15, C30 and R17 close to U6 and away from noisy power copper."
		(exclude_from_sim no)
		(at 96.266 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e4c906e6-3430-4d8e-bb6d-49c21f02bbf2")
	)
	(text "Kelvin VOUT sense: \nOUTS is the same electrical net as OUT. \nRoute OUTS separately from pin 9 to the COUT \npositive/load node, and join OUT there."
